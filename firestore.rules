rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A conta só pode ler e alterar o próprio progresso da trilha introdutória.
    match /users/{userId}/progress/{progressId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId
                  && progressId == 'fundamentals';

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && progressId == 'fundamentals'
                            && request.resource.data.keys().hasOnly(['schemaVersion', 'state', 'updatedAt'])
                            && request.resource.data.state is map;

      // O app não precisa apagar o progresso na nuvem.
      allow delete: if false;
    }
  }
}
